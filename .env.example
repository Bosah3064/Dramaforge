# DramaForge Environment Variables

# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (PostgreSQL)
DATABASE_URL="postgresql://dramaforge:dramaforge_secret_password@localhost:5432/dramaforge_db?schema=public"

# Redis (BullMQ Queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=super_secret_dramaforge_jwt_key_2026_production_change_me
JWT_EXPIRES_IN=7d

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=dramaforge-assets
S3_FORCE_PATH_STYLE=true

# AI Provider Configuration
# Mode: "mock" (offline dev, zero cost) | "live" (production)
AI_PROVIDER_MODE=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_VEO_API_KEY=
BYTEPLUS_API_KEY=

# RevenueCat / Billing Webhooks
REVENUECAT_WEBHOOK_AUTH_TOKEN=revcat_secret_token_123

# Admin Credentials (Initial Seeder)
ADMIN_INITIAL_EMAIL=admin@dramaforge.ai
ADMIN_INITIAL_PASSWORD=AdminSecure2026!
